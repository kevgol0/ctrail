<?xml version="1.0" encoding="UTF-8"?>
<ctrail>

  <!-- CTRAIL-8 fixture: explicit tailLast wins over both deprecated keys -->
  <inputFiles>
    <maxInputFileCount>1000</maxInputFileCount>
  </inputFiles>

  <execution>
    <maxProcessingLines>1000</maxProcessingLines>
    <maxPendingLines>100000</maxPendingLines>
    <prependFilenameToLine>true</prependFilenameToLine>

    <skipAheadInBytes>500</skipAheadInBytes>
    <tailLastLines>25</tailLastLines>
    <tailLast>
      <count>199</count>
      <unit>bytes</unit>
    </tailLast>

    <showStartupBanner>false</showStartupBanner>
    <idleNoticeSeconds>0</idleNoticeSeconds>

    <noChangeSleepTimeMillis>10</noChangeSleepTimeMillis>
    <useCaseSensitiveSarch>false</useCaseSensitiveSarch>
    <matchFirstWord>false</matchFirstWord>
  </execution>


  <coloring>
    <filename>
      <blankLineOnFileChange>false</blankLineOnFileChange>
    </filename>
    <linecolors>
      <defaultFgColor>white</defaultFgColor>
      <colorpair>
        <keyword>error</keyword>
        <fgcolor>red</fgcolor>
      </colorpair>
    </linecolors>
  </coloring>

</ctrail>
