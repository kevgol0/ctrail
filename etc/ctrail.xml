<?xml version="1.0" encoding="UTF-8"?>
<ctrail>

    <!-- max number of input files that can be opened at the same time -->
    <inputFiles>
        <maxInputFileCount>1000</maxInputFileCount>
    </inputFiles>

    <!-- controls execution -->
    <execution>
        <!-- indicates how many lines each thread can add to the queue -->
        <maxProcessingLines>1000</maxProcessingLines>

        <!-- indicates max number of outbound lines not yet written to output -->
        <maxPendingLines>100000</maxPendingLines>

        <prependFilenameToLine>true</prependFilenameToLine>

        <!-- legacy tail positioning, used only when tailLastLines is 0 -->
        <skipAheadInBytes>1000</skipAheadInBytes>

        <noChangeSleepTimeMillis>100</noChangeSleepTimeMillis>

        <!-- lines of history shown when a file is opened, the same idea as
            `tail -n N`. Line-accurate, so the first line is never cut in half.
            0 disables it and falls back to skipAheadInBytes above -->
        <tailLastLines>10</tailLastLines>

        <!-- print one banner line per input at startup, giving the file size and
            how long ago it last changed; "watching stdin" when piped. This is
            what tells you a file is stale before you have waited for anything -->
        <showStartupBanner>true</showStartupBanner>

        <!-- seconds of silence before ctrail says "no movement in ...". The
            notice repeats at this interval while the source stays quiet, and is
            followed by "resumed after ..." when data returns. 0 disables -->
        <idleNoticeSeconds>30</idleNoticeSeconds>

        <!-- indicates if the search should exit after if finds the FIRST word...
            if set to false, it will match the LAST word found that matches the list
            of words specified in the coloring seciont; this means, the ORDER in
            which words are added to the below list matters (CONFIG order, not line
            matching order) for your line matching -->
        <matchFirstWord>false</matchFirstWord>

        <!-- case sensitivity -->
        <useCaseSensitiveSarch>false</useCaseSensitiveSarch>
    </execution>


    <coloring>

        <!-- color for ctrail's own messages (startup banner, idle and resumed
            notices). These bypass keyword coloring, so a notice mentioning
            "error" is not rendered as an error line -->
        <noticeColor>cyan</noticeColor>

        <filename>
            <blankLineOnFileChange>false</blankLineOnFileChange>
        </filename>

        <!-- if any of the keywords are found on a line, then that line
            will be colored as specified... If multiple keywords are found
            on a line, then the line will be colored with the FIRST keyword
            found on that line -->
        <linecolors>
            <!-- COLORS ARE (case-insensitive):

                Regular:           BLACK, RED, GREEN, YELLOW, BLUE, PURPLE, CYAN, WHITE
                Bold:              BLACK_BOLD, RED_BOLD, GREEN_BOLD, ORANGE / YELLOW_BOLD,
                                   BLUE_BOLD, PURPLE_BOLD, CYAN_BOLD, WHITE_BOLD
                Underlined:        BLACK_UNDERLINED, RED_UNDERLINED, GREEN_UNDERLINED,
                                   YELLOW_UNDERLINED, BLUE_UNDERLINED, PURPLE_UNDERLINED,
                                   CYAN_UNDERLINED, WHITE_UNDERLINED
                Bright:            BLACK_BRIGHT, RED_BRIGHT, GREEN_BRIGHT, YELLOW_BRIGHT,
                                   BLUE_BRIGHT, PURPLE_BRIGHT, CYAN_BRIGHT, WHITE_BRIGHT
                Bold Bright:       BLACK_BOLD_BRIGHT, RED_BOLD_BRIGHT, GREEN_BOLD_BRIGHT,
                                   YELLOW_BOLD_BRIGHT, BLUE_BOLD_BRIGHT, PURPLE_BOLD_BRIGHT,
                                   CYAN_BOLD_BRIGHT, WHITE_BOLD_BRIGHT
                Background:        BLACK_BACKGROUND, RED_BACKGROUND, GREEN_BACKGROUND,
                                   YELLOW_BACKGROUND, BLUE_BACKGROUND, PURPLE_BACKGROUND,
                                   CYAN_BACKGROUND, WHITE_BACKGROUND
                Background Bright: BLACK_BACKGROUND_BRIGHT, RED_BACKGROUND_BRIGHT,
                                   GREEN_BACKGROUND_BRIGHT, YELLOW_BACKGROUND_BRIGHT,
                                   BLUE_BACKGROUND_BRIGHT, PURPLE_BACKGROUND_BRIGHT,
                                   CYAN_BACKGROUND_BRIGHT, WHITE_BACKGROUND_BRIGHT
            -->

            <defaultFgColor>white</defaultFgColor>



            <!-- full color par example:
                <colorpair>
                <keyword>(dbg)</keyword>
                <fgcolor>blue</fgcolor>
                <flcolor>blue_underline</flcolor>
                </colorpair>
            -->

            <colorpair>
                <keyword>(dbg)</keyword>
                <fgcolor>blue</fgcolor>
            </colorpair>

            <colorpair>
                <keyword>(inf)</keyword>
                <fgcolor>yellow</fgcolor>
            </colorpair>

            <colorpair>
                <keyword>(err)</keyword>
                <fgcolor>red</fgcolor>
            </colorpair>

            <colorpair>
                <keyword>(sev)</keyword>
                <fgcolor>red</fgcolor>
            </colorpair>

            <colorpair>
                <keyword>(wrn)</keyword>
                <fgcolor>purple</fgcolor>
            </colorpair>

            <colorpair>
                <keyword>(cfg)</keyword>
                <fgcolor>cyan</fgcolor>
            </colorpair>

        </linecolors>
    </coloring>

    <!-- this allows you to specify specific keywords of interest
        from specific files...
    -->
    <filtering>
        <!-- master switch; false attaches no filter to any file, so
            every line is shown. overridden by -f on the command line -->
        <enabled>true</enabled>

        <!-- applies the <excludes> lists below. set false to keep the
            includes while ignoring every exclude term. overridden by -v -->
        <excludesEnabled>true</excludesEnabled>

        <!-- verdict for a line that matched NEITHER list, on a source that
            does have a filter. false makes each filter a strict allow-list.

            NOTE this also decides for a <filefilter> that declares NO
            <includes> at all: with false, such a filter emits nothing.
            To write a deny-list ("hide DEBUG, show everything else") set this
            to true and use <excludes> alone. The setting is global, so a
            config cannot mix strict allow-lists and deny-lists. -->
        <fileFilterDefaultsToInclude>false</fileFilterDefaultsToInclude>


        <!-- applies when ctrail reads from a pipe rather than named files,
            eg. "kubectl logs -f mypod | ctr". no <filename> is needed;
            there is only ever one standard-in.

            <stdinfilter>
                <includes>
                    <keyword>geo-lookup</keyword>
                </includes>
                <excludes>
                    <keyword>heartbeat</keyword>
                </excludes>
            </stdinfilter>
        -->


        <filefilter>
            <filename>cityspark*.log.0</filename>
            <includes>
                <keyword>geo-lookup</keyword>
                <keyword>already contains subscription</keyword>
            </includes>
            <excludes />
        </filefilter>

        <filefilter>
            <filename>other.log</filename>
            <includes>
                <keyword>queried</keyword>
                <keyword>acc-create</keyword>
                <keyword>login</keyword>
            </includes>
        </filefilter>
    </filtering>

</ctrail>
