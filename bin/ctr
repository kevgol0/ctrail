#!/bin/bash

jvm=$(which java)
if [ "$jvm" == "" ]; then
    echo "java is required, but not found"
    echo "cannot continue"
    exit 1
fi

LIB="/usr/local/share/ctrail.jar"
if [ ! -e "$LIB" ]; then
    echo "library not found: $LIB"
    echo "run install.sh first"
    exit 1
fi

exec "$jvm" -Xmx64m -jar "$LIB" "$@"
